# Aurora AI — Environment Configuration Example

# Primary Database Connection URI (Supabase Shared Pooler / PostgreSQL with pgvector)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Optional fallback: Individual connection parameters (only required if DATABASE_URL is omitted)
# DB_HOST="aws-0-ap-southeast-1.pooler.supabase.com"
# DB_PORT="5432"
# DB_NAME="postgres"
# DB_USER="postgres.projectref"
# DB_PASSWORD="your-database-password"
# DB_SSL="true"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GNANI_API_KEY: Required for Gnani Prisma Speech-to-Text (STT) and Timbre (TTS).
GNANI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
